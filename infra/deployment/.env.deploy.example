# STEP pilot deployment env — copy to .env.deploy and fill in.
# NEVER commit .env.deploy. All keys below are for the internal testnet only.
# Generate fresh secrets per environment:  openssl rand -hex 24

# --- Chain accounts (internal testnet; the defaults are Anvil's well-known
#     deterministic accounts — replace for any non-local deployment) ---
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
WORKER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
MANAGED_MERCHANT_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# --- Validator keys + their derived addresses (cast wallet address <key>) ---
VALIDATOR_1_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
VALIDATOR_2_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
VALIDATOR_3_KEY=0x3333333333333333333333333333333333333333333333333333333333333333
# comma-separated addresses matching the keys above (used for on-chain registration)
VALIDATOR_ADDRS=0x19E7E376E7C213B7E7e7e46cc70A5dD086DAff2A,0x1563915e194D8CfBA1943570603F7606A3115508,0x5CbDd86a2FA8Dc4bDdd8a8f69dBa48572EeC07FB

# --- Shared secrets (generate fresh; openssl rand -hex 24, and -hex 32 for the key) ---
GATEWAY_NONCE_SECRET=CHANGE_ME_hex24
MERCHANT_QR_SECRET=CHANGE_ME_hex24
FOUNDATION_API_TOKEN=CHANGE_ME_hex24
EVIDENCE_MASTER_KEY=CHANGE_ME_hex32_64chars

# --- Infra passwords ---
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME

# --- Protocol parameter timelock (seconds). 0 only for throwaway local dev. ---
STEP_PARAM_DELAY=86400

# --- Public URLs baked into the web app builds (set to the host's reachable
#     addresses behind your reverse proxy / TLS termination) ---
PUBLIC_INDEXER_URL=http://localhost:8090
PUBLIC_MESH_API_URL=http://localhost:9101

# Comma-separated browser origins allowed to call gateway/indexer APIs.
# Examples:
# STEP_CORS_ORIGINS=https://yourname.github.io,https://miner.example.com
STEP_CORS_ORIGINS=http://localhost:3010

# --- account-api (#12): zero-knowledge wallet vault + sessions ---
# REQUIRED in production. Generate: openssl rand -hex 32
SESSION_SIGNING_KEY=CHANGE_ME
SESSION_TTL_SECONDS=86400
SECURE_COOKIES=true
# Optional Postgres adapter; unset → in-memory store.
ACCOUNT_DATABASE_URL=

# --- nft-indexer (#6/#7/#10): NFT metadata external_url base (optional) ---
NFT_METADATA_BASE_URL=
