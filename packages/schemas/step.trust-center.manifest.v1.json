{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://step.protocol/schemas/step.trust-center.manifest.v1.json",
  "title": "STEP Trust Center Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node",
    "roles",
    "services",
    "chain",
    "update",
    "recovery",
    "observability"
  ],
  "properties": {
    "schema_version": {
      "const": "step.trust-center.manifest.v1"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "transport", "platform", "location"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "peer_id": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": ["http", "peer"]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "identity_backend": {
          "type": "string",
          "enum": ["keychain", "secret-service", "file"]
        },
        "owner_wallet": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "agent",
          "validator",
          "gossip",
          "chain",
          "bootstrap",
          "relay",
          "gateway",
          "indexer",
          "fleet",
          "artifact"
        ]
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/service" },
        "validator": { "$ref": "#/$defs/service" },
        "gossip": { "$ref": "#/$defs/service" },
        "chain_rpc": { "$ref": "#/$defs/service" },
        "gateway": { "$ref": "#/$defs/service" },
        "indexer": { "$ref": "#/$defs/service" },
        "fleet": { "$ref": "#/$defs/service" },
        "artifact": { "$ref": "#/$defs/service" }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrap_peers": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiaddr" }
        },
        "relay_peers": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiaddr" }
        },
        "advertise": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiaddr" }
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "rpc_urls", "release_registry", "validator_registry"],
      "properties": {
        "chain_id": {
          "type": "string",
          "minLength": 1
        },
        "rpc_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/url" }
        },
        "release_registry": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "validator_registry": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "genesis_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_id", "artifact_base_urls", "poll_interval_s"],
      "properties": {
        "platform_id": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "artifact_base_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/url" }
        },
        "poll_interval_s": {
          "type": "integer",
          "minimum": 5
        },
        "integrity_interval_s": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supervisor", "restart", "rollback"],
      "properties": {
        "supervisor": {
          "type": "string",
          "enum": ["launchd", "systemd", "manual"]
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "max_attempts"],
          "properties": {
            "enabled": { "type": "boolean" },
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "last_good_required"],
          "properties": {
            "enabled": { "type": "boolean" },
            "last_good_required": { "type": "boolean" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthz", "logs", "fleet_heartbeat"],
      "properties": {
        "healthz": { "$ref": "#/$defs/url" },
        "logs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fleet_heartbeat": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^(https?://|file://).+"
    },
    "multiaddr": {
      "type": "string",
      "pattern": "^/.+"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "bind": {
          "type": "string",
          "minLength": 1
        },
        "public_url": { "$ref": "#/$defs/url" },
        "healthz": { "$ref": "#/$defs/url" },
        "pid_file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
