{
  "name": "step-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "STEP proof-of-presence blockchain system monorepo",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:cloudflare-pages": "pnpm --filter @step/static-frontend build",
    "deploy:cloudflare-pages": "pnpm --dir apps/static-frontend deploy:cloudflare",
    "deploy:cloudflare-worker": "pnpm --dir apps/static-frontend deploy:cloudflare-worker",
    "deploy:cloudflare-worker:env": "set -a; source .env; set +a; pnpm --dir apps/static-frontend deploy:cloudflare-worker",
    "deploy:cloudflare-worker:strict": "bash scripts/ops/deploy-cloudflare-worker.sh",
    "dev:full-stack": "node scripts/dev/start-full-stack.mjs",
    "start:non-sandbox-webapp": "node scripts/start-non-sandbox.mjs",
    "release:macos-pkg": "node scripts/release/build-macos-pkg.mjs",
    "release:macos-pkg:test": "node scripts/release/test-macos-pkg-e2e.mjs",
    "release:macos-pkg:notarize": "node scripts/release/notarize-macos-pkg.mjs",
    "trust-center:manifest:validate": "node scripts/node/validate-manifest.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "release:public-edge:verify": "node scripts/ops/verify-public-edge.mjs",
    "release:prod-safety:scan": "node scripts/release/scan-production-safety.mjs",
    "test:scripts": "node --test scripts/release/*.test.mjs",
    "release:p2p-independence:verify": "node scripts/ops/verify-p2p-independence.mjs",
    "release:live-federation:verify": "node scripts/ops/verify-live-federation.mjs",
    "release:disaster-survival:verify": "node scripts/ops/verify-disaster-survival.mjs",
    "release:system-identity:verify": "node scripts/ops/verify-system-identity.mjs",
    "release:p2p-update-swarm:verify": "node scripts/ops/verify-p2p-update-swarm.mjs",
    "release:main-system-handoff": "node scripts/ops/main-system-handoff.mjs"
  },
  "packageManager": "pnpm@11.5.1"
}
