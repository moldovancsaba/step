# Cloudflare deployment runtime for @step/static-frontend
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=step

# Non-sensitive Worker routing values (can be set before deploy)
STEP_BACKEND_GATEWAY_URL=http://127.0.0.1:8080/api/gateway
STEP_BACKEND_INDEXER_URL=http://127.0.0.1:8090/api/indexer
STEP_WEB_EXPLORER_URL=/explorer
STEP_WEB_MINER_URL=/miner

# Optional R2/S3-compatible sync credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com

# account-api (#12): zero-knowledge encrypted wallet vault + session cookies.
# SESSION_SIGNING_KEY is REQUIRED in production (random in dev).
SESSION_SIGNING_KEY=
ACCOUNT_PORT=8091
SESSION_TTL_SECONDS=86400
SECURE_COOKIES=true
# Postgres adapter; unset → in-memory dev store.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# iOS app (apps/ios/App) — endpoint configuration consumed by Info.plist →
# AppConfig (build settings; NOT secrets). Override per build configuration via
# an .xcconfig. Empty → app uses its compiled-in placeholder defaults.
# ─────────────────────────────────────────────────────────────────────────────
STEP_GATEWAY_URL=
STEP_MESH_URL=
STEP_INDEXER_URL=
STEP_ACCOUNT_URL=
STEP_NFT_INDEXER_URL=
# Marketplace trading is enabled only when ALL of these are set:
STEP_RPC_URL=
STEP_MARKETPLACE_ADDRESS=
STEP_NFT_ADDRESS=
STEP_TRINITY_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Apple Developer / App Store Connect — used to sign, archive, and upload the
# iOS app to TestFlight/App Store (see docs/operations/STEP_secrets_and_credentials.md).
# The IDs below are identifiers (not secret). The actual SECRET is the .p8
# private key file, which lives OUTSIDE the repo at:
#   ~/.appstoreconnect/private_keys/AuthKey_<APPLE_ASC_KEY_ID>.p8
# (also mirrored to ~/.private_keys/ — both are read by Xcode/altool).
# ─────────────────────────────────────────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_ASC_KEY_ID=
APPLE_ASC_ISSUER_ID=
APPLE_ASC_APP_ID=
APPLE_BUNDLE_ID=com.regiominer.miner
