# Cloudflare deployment runtime for @step/static-frontend
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=step

# Non-sensitive Worker routing values (can be set before deploy)
STEP_BACKEND_GATEWAY_URL=http://127.0.0.1:8080/api/gateway
STEP_BACKEND_INDEXER_URL=http://127.0.0.1:8090/api/indexer
STEP_WEB_EXPLORER_URL=/explorer
STEP_WEB_MINER_URL=/miner

# Optional R2/S3-compatible sync credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com

# account-api (#12): zero-knowledge encrypted wallet vault + session cookies.
# SESSION_SIGNING_KEY is REQUIRED in production (random in dev).
SESSION_SIGNING_KEY=
ACCOUNT_PORT=8091
SESSION_TTL_SECONDS=86400
SECURE_COOKIES=true
# Postgres adapter; unset → in-memory dev store.
DATABASE_URL=
