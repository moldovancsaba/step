# STEP environment template (DEV §19.3). Copy to .env.local — never commit real values.

# Chain (ADR-006: Anvil local / internal testnet)
STEP_CHAIN_ID=31337
STEP_RPC_URL=http://127.0.0.1:8545
# Contract addresses are written by the deploy script into contracts/deployments/<chain>.json
STEP_DEPLOYMENTS_FILE=contracts/deployments/31337.json

# Protocol parameters
STEP_PROTOCOL_PARAMS=config/protocol-params.alpha.json

# Database
DATABASE_URL=postgres://step:step_local_dev_only@127.0.0.1:5432/step

# IPFS
IPFS_API_URL=http://127.0.0.1:5001

# Redis (campaign-worker jobs)
REDIS_URL=redis://127.0.0.1:6379

# Gateway
GATEWAY_PORT=8080
# Secret used to sign nonce challenges (generate per environment)
GATEWAY_NONCE_SECRET=

# Validator node (one per node; never share keys between nodes)
VALIDATOR_PRIVATE_KEY=
VALIDATOR_METRICS_PORT=9464
# ADR-015: must be false on every pilot validator
VALIDATOR_ALLOW_DEV_CLAIMS=true

# Relayer key used to submit accepted claims on-chain (alpha: foundation-operated)
RELAYER_PRIVATE_KEY=
