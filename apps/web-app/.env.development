# Local-first backend: every STEP service runs on THIS computer (see
# scripts/dev/up.mjs). `pnpm --filter @step/web-app dev` reads this file, so the
# web app talks to the native stack on localhost — no Cloudflare, no remote.
#
# Hosts use `localhost` (not 127.0.0.1) consistently so the session cookie is
# same-site across the dev ports. Public-only URLs, no secrets.
VITE_ACCOUNT_URL=http://localhost:8091
VITE_MESH_URL=http://localhost:9101
VITE_INDEXER_URL=http://localhost:8090
VITE_NFT_URL=http://localhost:8092
VITE_FLEET_URL=http://localhost:8099
