# Production backend URLs for the web app (Vite reads this during `vite build`).
# Use same-origin Worker proxy paths so browser calls do not depend on cross-site
# CORS or cookies. The root Worker routes these to the public trust-center
# backends configured in wrangler.toml.
VITE_ACCOUNT_URL=/api/account
VITE_MESH_URL=/api/gateway
VITE_INDEXER_URL=/api/indexer
VITE_NFT_URL=/api/nft
