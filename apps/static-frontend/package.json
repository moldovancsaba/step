{
  "name": "@step/static-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3010",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3010",
    "deploy:cloudflare": "pnpm dlx wrangler pages deploy dist",
    "deploy:cloudflare-worker": "pnpm dlx wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@step/api-client": "workspace:*",
    "@step/proof-protocol": "workspace:*",
    "@step/shared-types": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
